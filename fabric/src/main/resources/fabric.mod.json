{
  "schemaVersion": 1,
  "id": "miehex",
  "version": "${version}",
  "name": "miehex",
  "description": "miehex (big package) addon for Hex Casting.",
  "authors": [
    "xm1221"
  ],
  "contact": {
    "homepage": "https://xm1221.github.io/miehex_for_bigpackage",
    "sources": "https://github.com/xm1221/miehex_for_bigpackage"
  },
  "license": "MIT",
  "icon": "assets/miehex/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [{
      "adapter": "kotlin",
      "value": "cn.xm1221.miehex.fabric.FabricMiehex"
    }],
    "client": [{
      "adapter": "kotlin",
      "value": "cn.xm1221.miehex.fabric.FabricMiehexClient"
    }],
    "server": [{
      "adapter": "kotlin",
      "value": "cn.xm1221.miehex.fabric.FabricMiehexServer"
    }],
    "fabric-datagen": [{
      "adapter": "kotlin",
      "value": "cn.xm1221.miehex.fabric.datagen.FabricMiehexDatagen"
    }],
    "modmenu": [{
      "adapter": "kotlin",
      "value": "cn.xm1221.miehex.fabric.FabricMiehexModMenu"
    }]
  },
  "mixins": [
    "miehex-common.mixins.json",
    "miehex-fabric.mixins.json"
  ],
  "depends": {
    "minecraft": "${versions.minecraft}",
    "fabricloader": ">=${versions.fabric_loader}",
    "fabric-api": ">=${versions.fabric_api}",
    "fabric-language-kotlin": ">=${versions.kotlin_fabric}",
    "architectury": ">=${versions.architectury}",
    "hexcasting": ">=${versions.hexcasting}",
    "cloth-config": ">=${versions.clothConfig}"
  },
  "suggests": {
    "modmenu": ">=${versions.modMenu}",
    "hexparse": "*"
  }
}
